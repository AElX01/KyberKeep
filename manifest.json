{
  "manifest_version": 3,
  "name": "KyberKeep",
  "version": "1.0",
  "description": "Autofill and save passwords securely.",
  "action": {
    "default_popup": "views/login.html",
    "default_icon": {
      "16": "assets/icon/Logo.png",
      "48": "assets/icon/Logo.png",
      "128": "assets/icon/Logo.png"
    }
  },
  "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "identity",
      "tabs"
    ],
    "background": {
    "service_worker": "js/background.js"
    },
    "host_permissions": [
      "<all_urls>"
    ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["views/sandbox.html", "cryptography_rs/pkg/cryptography_rs_bg.wasm"],
      "matches": ["<all_urls>"]
    }
  ],
  "sandbox": {
    "pages": [
      "views/sandbox.html"
    ]
  },
  "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
